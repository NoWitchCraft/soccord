# ==============================================================================
# SOCCORD CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your private credentials.
# ==============================================================================

# DISCORD CONFIGURATION
# The Webhook URL from your Discord channel integration
DISCORD_WEBHOOK_URL=https://discord.com

# BOT CONFIGURATION
# The name that will appear as the sender in Discord
BOT_NAME=SOCCord Threat Intelligence

# MONITORING CONFIGURATION
# Path to the log file that soccord should watch (e.g., auth.log, syslog, or app.log)
LOG_FILE_PATH=/var/log/auth.log

# SECURITY SETTINGS
# Minimum level of alerts to send to Discord (DEBUG, INFO, WARNING, ERROR, CRITICAL)
MIN_ALERT_LEVEL=WARNING

# Optional: Environment name to know which server sent the alert
ENVIRONMENT=Production-Server-01
